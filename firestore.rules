rules_version = '2';
// Regras do banco da loja EKKLESIA (Firebase ekklesia-loja).
// Cliente: só os próprios dados e pedidos. Admin: e-mail da marca confirmado.
// Custos, estoque e configurações internas ficam em /interno (só admin).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['jhonatta258@gmail.com'];
    }

    match /clientes/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /pedidos/{id} {
      // o id é aleatório: quem tem o link de acompanhamento consegue ver o pedido
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if request.resource.data.status == 'aguardando_pagamento'
        && request.resource.data.pago == 0
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total < 50000
        && request.resource.data.itens is list && request.resource.data.itens.size() > 0 && request.resource.data.itens.size() <= 60;
      allow update, delete: if isAdmin();
    }

    match /interno/{doc=**} {
      allow read, write: if isAdmin();
    }
  }
}
